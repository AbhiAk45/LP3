
def fractional_knapsack(n, values, weights, capacity):

    ratio = []

    for i in range(n):
        ratio.append(values[i] / weights[i])

    # Sort according to ratio
    for i in range(n):
        for j in range(i + 1, n):
            if ratio[i] < ratio[j]:
                ratio[i], ratio[j] = ratio[j], ratio[i]
                values[i], values[j] = values[j], values[i]
                weights[i], weights[j] = weights[j], weights[i]

    total_profit = 0

    for i in range(n):
        if weights[i] <= capacity:
            total_profit += values[i]
            capacity -= weights[i]
        else:
            total_profit += ratio[i] * capacity
            break

    return total_profit


n = int(input("Enter number of items: "))

values = []
weights = []

for i in range(n):
    values.append(int(input("Enter profit: ")))
    weights.append(int(input("Enter weight: ")))

capacity = int(input("Enter capacity: "))

print("Maximum Profit:", fractional_knapsack(n, values, weights, capacity))
